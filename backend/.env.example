# SentinelX Backend Environment Variables
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter for GuardLayer LLM scanning (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Algorand auth + audit
ALGO_ALGOD_URL=https://testnet-api.algonode.cloud
ALGO_ALGOD_TOKEN=
ALGO_APP_ID=0
ALGO_MNEMONIC=word1 word2 word3 ... word25
ALGO_NETWORK=testnet
ALGO_EXPLORER_TX_BASE=https://testnet.explorer.perawallet.app/tx/

# Database (PostgreSQL)
# For local development against hosted providers like Render, use the EXTERNAL
# URL and enable TLS.
DATABASE_URL=postgresql://user:password@host:5432/sentinelx
DATABASE_SSL_MODE=require
RESET_DB_ON_STARTUP=false

# CORS
FRONTEND_URL=http://localhost:5173

# Optional backward-compatible aliases still supported by the backend:
# ALGORAND_NODE_URL=
# ALGORAND_NODE_TOKEN=
# ALGO_DEPLOYER_MNEMONIC=
# AUDIT_APP_ID=
# ALGORAND_NETWORK=
